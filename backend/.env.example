# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── Application ───────────────────────────────────────────────
APP_NAME="Career AI Backend"
APP_VERSION="1.0.0"
DEBUG=false

# ─── Ollama ────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=120

# ─── ChromaDB ──────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=career_docs

# ─── Embeddings ────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Chunking ──────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ─── File Upload ───────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=pdf,docx,txt

# ─── Retrieval ─────────────────────────────────────────────────
TOP_K_RESULTS=5
SCORE_THRESHOLD=0.3
